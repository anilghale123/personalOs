# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.
#
# src/lib/env.js validates all of this at boot. Anything marked REQUIRED
# aborts startup if missing; the rest logs a warning naming what it disables.

# ─── REQUIRED ────────────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas recommended).
# If your network blocks DNS SRV lookups, use the standard (non-SRV)
# mongodb:// string from Atlas → Connect → Drivers instead of mongodb+srv://.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# NextAuth v5 — generate with: openssl rand -base64 32
# Must be at least 32 characters. Changing it signs everyone out.
AUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# Your app's own origin. MUST be the real https:// origin in production —
# every OAuth callback is built from it, and a localhost value in production
# breaks Google sign-in entirely.
NEXTAUTH_URL=http://localhost:3000

# ─── GOOGLE SIGN-IN (all-or-nothing) ─────────────────────────────────────
#
# Set BOTH or NEITHER. With one missing, "Continue with Google" silently
# does not render — for every user, with no error anywhere — so env.js
# treats a half-configured pair as a fatal error rather than a warning.
#
# Create credentials at https://console.cloud.google.com
# Authorised redirect URIs must include EVERY origin you deploy to:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-production-domain>/api/auth/callback/google
# A missing production URI is the single most common cause of Google
# sign-in working locally and failing once deployed.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# ─── RATE LIMITING (required in production) ──────────────────────────────
#
# Without these, rate limiting falls back to an in-process Map. Serverless
# runs many instances, so that fallback is bypassed simply by being routed
# elsewhere — which means login throttling and AI cost caps do not really
# exist. Create a free database at https://upstash.com (Redis → REST API).
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── TRANSACTIONAL EMAIL (required for password reset) ───────────────────
#
# Password reset emails a 6-digit code (15 min expiry, 5 attempts, 60s
# resend cooldown). Configure SMTP *or* Resend; SMTP wins if both are set.
# With neither, the email is printed to the server console in development
# and refused outright in production.
#
# SMTP — any provider (Gmail app password, Zoho, Brevo, SES…).
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=SelfView <noreply@yourdomain.com>
#
# Or Resend — https://resend.com
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=SelfView <noreply@yourdomain.com>

# ─── PLANS ───────────────────────────────────────────────────────────────
#
# Pro unlocks bank statement import. Set per user via the admin Users page
# (plan column), or allowlist emails here (comma-separated). Admins and
# super admins always count as Pro so they can test gated features.
# PRO_EMAILS=someone@example.com,another@example.com

# ─── AI FEATURES ─────────────────────────────────────────────────────────

# Groq — get a key at https://console.groq.com
# Without it, briefings, reflections, journal extraction and insight
# narration all fail at call time. Every AI route is rate limited per user
# (10/hour, 40/day) because the quota is shared across all users.
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional. Defaults to openai/gpt-oss-120b (Groq's replacement for
# llama-3.3-70b-versatile, which shut down 16 Aug 2026).
# GROQ_MODEL=openai/gpt-oss-120b

# ─── CRON ────────────────────────────────────────────────────────────────

# Protects the NEPSE cron route — generate with: openssl rand -hex 32
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=replace-with-a-strong-random-hex

# ─── OPTIONAL ────────────────────────────────────────────────────────────

# Used for absolute URLs in metadata and OpenGraph images.
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
